+private struct Entry: Comparable, Codable {
+  var reading: String
+  var value: String
+  var category: String
+  static func < (lhs: Entry, rhs: Entry) -> Bool {
+    lhs.reading == rhs.reading ? lhs.value < rhs.value : lhs.reading < rhs.reading
+  }
+}
