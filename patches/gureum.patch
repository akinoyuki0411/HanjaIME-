+// counts is locked; all UserDefaults writes run on writer, in enqueue order.
+final class HanjaIMEUsageStore: @unchecked Sendable {
+  static let domain = HanjaIMEStorage.learningDomain
+  static let shared = HanjaIMEUsageStore(defaults: HanjaIMEStorage.learningDefaults())
+  private let defaults: UserDefaults
+  private let storageKey = HanjaIMEStorage.selectionCountsKey
+  private let recentKey = "HanjaIME.LastSelection.v1"
+  private let personalKey = "HanjaIME.PersonalDictionary.v1"
+  private let personalCategoryKey = "HanjaIME.PersonalDictionaryCategory.v1"
+  private let resetRevisionKey = "HanjaIME.LearningResetRevision.v1"
+  private var resetRevision: String?
+  private let lock = NSLock()
+  private let writer = DispatchQueue(label: "org.hanjaime.learning", qos: .utility)
+  private var counts: [String: [String: Int]]
+  private var recent: [String: [String: Double]]
+  private var personal: [String: [String]]
+  private var personalCategories: [String: [String: String]]
+
+  init(defaults: UserDefaults) {
+    self.defaults = defaults
+    resetRevision = defaults.string(forKey: resetRevisionKey)
+    let stored = defaults.dictionary(forKey: storageKey) as? [String: [String: Int]] ?? [:]
+    var valid: [String: [String: Int]] = [:]
