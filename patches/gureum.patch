+      valid[reading] = values
+    }
+    counts = valid
+    let savedRecent = defaults.dictionary(forKey: recentKey) as? [String: [String: Double]] ?? [:]
+    recent = valid.mapValues { _ in [:] }
+    for (reading, values) in valid {
+      for value in values.keys {
+        if let date = savedRecent[reading]?[value], date.isFinite, date > 0 {
+          recent[reading, default: [:]][value] = min(date, Date().timeIntervalSince1970)
+        }
+      }
+    }
+    // Fresh installations start empty; only explicitly saved personal entries are loaded.
+    let savedPersonal = defaults.dictionary(forKey: personalKey) as? [String: [String]]
+      ?? [:]
+    personal = [:]
+    personalCategories = defaults.dictionary(forKey: personalCategoryKey) as? [String: [String: String]] ?? [:]
+    for reading in savedPersonal.keys.sorted().prefix(2000) where HanjaIMERanking.isReading(reading) {
+      var seen = Set<String>()
+      let values = savedPersonal[reading]!.filter {
+        Self.validPersonal(value: $0, category: personalCategories[reading]?[$0]) && seen.insert($0).inserted
+      }
+      if !values.isEmpty { personal[reading] = Array(values.prefix(64)) }
+    }
+  }
+
+  private func reloadPersonalLocked() {
+    guard let saved = defaults.dictionary(forKey: personalKey) as? [String: [String]] else { return }
+    personalCategories = defaults.dictionary(forKey: personalCategoryKey) as? [String: [String: String]] ?? [:]
+    var refreshed: [String: [String]] = [:]
+    for reading in saved.keys.sorted().prefix(2000) where HanjaIMERanking.isReading(reading) {
+      let values = saved[reading]!
+      var seen = Set<String>()
+      let valid = values.filter { Self.validPersonal(value: $0, category: personalCategories[reading]?[$0]) && seen.insert($0).inserted }
+      if !valid.isEmpty { refreshed[reading] = Array(valid.prefix(64)) }
+    }
+    personal = refreshed
+  }
+
+  func snapshot(reading: String) -> [String: Int] {
+    lock.lock()
+    defer { lock.unlock() }
+    reloadResetLocked()
+    return counts[reading] ?? [:]
+  }
+
+  func recency(reading: String) -> [String: Double] {
+    lock.lock()
+    defer { lock.unlock() }
+    reloadResetLocked()
+    return recent[reading] ?? [:]
+  }
+
+  func personalCandidates(reading: String) -> [HanjaIMECandidate] {
+    lock.lock()
+    defer { lock.unlock() }
+    // A manager app can change this shared suite while the input method is
+    // running.  Refreshing this small bounded dictionary makes that visible on
+    // the next keystroke without an input-method restart.
+    reloadPersonalLocked()
+    return (personal[reading] ?? []).map { value in
+      let stored = personalCategories[reading]?[value]
+      let category = HanjaIMECandidateCategory.allCases.first { $0.storageValue == stored } ?? .names
+      let kind: HanjaIMECandidate.Kind = category == .shinjitai ? .japanese
+        : category == .symbols ? (HanjaIMERanking.isEmoji(value) ? .emoji : .symbol) : .hanja
+      return HanjaIMECandidate(value: value,
+        annotation: category == .names ? "개인 이름" : "개인 단어", kind: kind,
+        personal: true, personalCategory: category)
+    }
+  }
+
+  @discardableResult
+  func register(reading: String, value: String,
+                category: HanjaIMECandidateCategory = .names) -> Bool {
+    guard HanjaIMERanking.isReading(reading), Self.validPersonal(value: value, category: category.storageValue),
+      category == .symbols || reading.count == value.count else { return false }
+    lock.lock()
+    defer { lock.unlock() }
+    reloadPersonalLocked()
+    guard personal[reading] != nil || personal.count < 2000 else { return false }
+    let values = personal[reading] ?? []
+    guard values.contains(value) || values.count < 64 else { return false }
+    personal[reading] = [value] + values.filter { $0 != value }
+    personalCategories[reading, default: [:]][value] = category.storageValue
+    let snapshot = personal
+    let categorySnapshot = personalCategories
+    writer.sync { [self] in
+      defaults.set(snapshot, forKey: personalKey)
+      defaults.set(categorySnapshot, forKey: personalCategoryKey)
+      defaults.synchronize()
+    }
+    return true
+  }
+
+  @discardableResult
+  func removePersonal(reading: String, value: String) -> Bool {
+    lock.lock()
+    defer { lock.unlock() }
+    reloadPersonalLocked()
+    guard let values = personal[reading], values.contains(value) else { return false }
+    let remaining = values.filter { $0 != value }
+    if remaining.isEmpty { personal.removeValue(forKey: reading) }
+    else { personal[reading] = remaining }
+    personalCategories[reading]?.removeValue(forKey: value)
+    if personalCategories[reading]?.isEmpty == true { personalCategories.removeValue(forKey: reading) }
+    let snapshot = personal
+    let categorySnapshot = personalCategories
+    writer.sync { [self] in
+      defaults.set(snapshot, forKey: personalKey)
+      defaults.set(categorySnapshot, forKey: personalCategoryKey)
+      defaults.synchronize()
+    }
+    return true
+  }
+
+  func record(reading: String, value: String) {
+    guard HanjaIMERanking.isReading(reading), HanjaIMERanking.isLearnable(value) else { return }
+    lock.lock()
+    defer { lock.unlock() }
+    reloadResetLocked()
+    if counts[reading] == nil, counts.count >= 2000 {
+      // Bounded storage; evict the least-used reading with a deterministic tie-break.
+      if let victim = counts.keys.min(by: {
+        let a = counts[$0]!.values.reduce(0, +)
+        let b = counts[$1]!.values.reduce(0, +)
+        return a == b ? $0 < $1 : a < b
+      }) { counts.removeValue(forKey: victim); recent.removeValue(forKey: victim) }
+    }
+    var values = counts[reading] ?? [:]
+    if values[value] == nil, values.count >= 64,
+      let victim = values.keys.min(by: {
+        values[$0] == values[$1] ? $0 < $1 : values[$0]! < values[$1]!
+      }) { values.removeValue(forKey: victim); recent[reading]?.removeValue(forKey: victim) }
+    values[value] = min(1_000_000, (values[value] ?? 0) + 1)
+    counts[reading] = values
+    recent[reading, default: [:]][value] = Date().timeIntervalSince1970
+    let snapshot = counts
+    let recentSnapshot = recent
+    let revision = resetRevision
+    writer.async { [self] in
+      guard defaults.string(forKey: resetRevisionKey) == revision else { return }
+      defaults.set(snapshot, forKey: storageKey)
+      defaults.set(recentSnapshot, forKey: recentKey)
+    }
+  }
+
+  func reset() {
+    lock.lock()
+    defer { lock.unlock() }
+    counts = [:]
+    recent = [:]
+    resetRevision = UUID().uuidString
+    writer.sync { [self] in
+      defaults.set(resetRevision, forKey: resetRevisionKey)
+      defaults.removeObject(forKey: storageKey)
+      defaults.removeObject(forKey: recentKey)
+      defaults.synchronize()
+    }
+  }
+
+  private static func validPersonal(value: String, category: String?) -> Bool {
+    guard value.count <= 64 else { return false }
+    return category == HanjaIMECandidateCategory.symbols.storageValue
+      ? HanjaIMERanking.isEmoji(value) || HanjaIMERanking.isSymbol(value)
+      : HanjaIMERanking.isHanja(value)
+  }
+
+  private func reloadResetLocked() {
+    let revision = defaults.string(forKey: resetRevisionKey)
+    if revision != resetRevision {
+      counts = [:]
+      recent = [:]
+      resetRevision = revision
+    }
+  }
+
+  func allPersonalWords() -> [(reading: String, value: String, category: HanjaIMECandidateCategory)] {
+    lock.lock()
+    defer { lock.unlock() }
+    reloadPersonalLocked()
+    return personal.keys.sorted().flatMap { reading in
+      (personal[reading] ?? []).map { value in
+        let stored = personalCategories[reading]?[value]
+        return (reading, value, HanjaIMECandidateCategory.allCases.first {
+          $0.storageValue == stored
+        } ?? .names)
+      }
+    }
+  }
+
+  func flush() { writer.sync {} }
+}
