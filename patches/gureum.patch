+import Foundation
+#if canImport(CoreGraphics)
+import CoreGraphics
+#endif
+
+/// Screen-space geometry shared by AppKit and the portable regression suite.
+enum HanjaIMEPanelLayout {
+  static func characterIndices(selected: NSRange, marked: NSRange) -> [Int] {
+    var indices: [Int] = []
+    if selected.location != NSNotFound { indices.append(selected.location) }
+    if marked.location != NSNotFound, marked.length <= Int.max - marked.location {
+      indices += [marked.location + marked.length, marked.location]
+    }
+    // IMK accepts NSNotFound to ask for the current insertion location.
+    indices.append(NSNotFound)
+    var seen = Set<Int>()
+    return indices.filter { seen.insert($0).inserted }
+  }
+
+  static func validCaret(_ rect: CGRect, screens: [CGRect]) -> Bool {
+    rect.minX.isFinite && rect.minY.isFinite && rect.width.isFinite && rect.height.isFinite
+      && rect.width >= 0 && rect.height > 0 && rect.height < 200
+      && screens.contains { $0.insetBy(dx: -2, dy: -2).contains(rect.origin) }
+  }
+
+  static func size(rows: Int, textWidth: CGFloat, paged: Bool) -> CGSize {
+    CGSize(width: min(280, max(rows <= 4 ? 150 : 214, textWidth + 52)),
+           height: 30 + CGFloat(max(1, min(9, rows))) * 26 + (paged ? 20 : 0))
+  }
+
+  static func candidate(caret: CGRect, size: CGSize, visible: CGRect) -> CGRect {
+    let width = min(size.width, visible.width), height = min(size.height, visible.height)
+    let below = caret.minY - height - 2
+    let y = below >= visible.minY ? below : caret.maxY + 2
+    return CGRect(x: max(visible.minX, min(caret.minX, visible.maxX - width)),
+      y: max(visible.minY, min(y, visible.maxY - height)), width: width, height: height)
+  }
+
+  static func candidate(previous: CGRect, size: CGSize, visible: CGRect) -> CGRect {
+    let width = min(size.width, visible.width), height = min(size.height, visible.height)
+    return CGRect(x: max(visible.minX, min(previous.minX, visible.maxX - width)),
+      y: max(visible.minY, min(previous.minY, visible.maxY - height)), width: width, height: height)
+  }
+
+  static func definition(candidate: CGRect, size: CGSize, visible: CGRect) -> CGRect {
+    let gap: CGFloat = 4
+    let right = visible.maxX - candidate.maxX - gap
+    let left = candidate.minX - visible.minX - gap
+    let useRight = right >= size.width || (left < size.width && right >= left)
+    let available = max(0, useRight ? right : left)
+    if available >= 120 {
+      let width = min(size.width, available), height = min(size.height, visible.height)
+      return CGRect(x: useRight ? candidate.maxX + gap : candidate.minX - gap - width,
+        y: max(visible.minY, min(candidate.maxY - height, visible.maxY - height)),
+        width: width, height: height)
+    }
+    let above = visible.maxY - candidate.maxY - gap
+    let below = candidate.minY - visible.minY - gap
+    let width = min(size.width, visible.width), height = max(0, min(size.height, max(above, below)))
+    return CGRect(x: max(visible.minX, min(candidate.minX, visible.maxX - width)),
+      y: above >= below ? candidate.maxY + gap : candidate.minY - gap - height,
+      width: width, height: height)
+  }
+
+  static func windowLevel(host: Int, normal: Int, ceiling: Int) -> Int {
+    max(normal, min(host, ceiling - 1) + 1)
+  }
+}
+
+struct HanjaIMECandidate: Equatable {
+  // Keep the origin with the candidate.  It is used by filtering, ranking and
+  // Dictionary Services; the UI never needs a second hard-coded list.
+  enum Kind { case hanja, japanese, emoji, symbol, kaomoji }
+  let value: String
+  let annotation: String
+  var kind: Kind = .hanja
+  var personal = false
+  var predicted = false
+  var semantic = false
+  var frequency = 0
+  // Inflected candidates display the suffix, but learn the dictionary stem.
+  var sourceReading: String? = nil
+  var sourceValue: String? = nil
+  var personalCategory: HanjaIMECandidateCategory? = nil
+}
+
+enum HanjaIMECandidateCategory: Int, CaseIterable {
+  case standard, hanja, names, shinjitai, symbols
+  var title: String { ["표준", "한자", "이름", "신자체", "기호"][rawValue] }
+  var storageValue: String { ["standard", "hanja", "name", "shinjitai", "symbol"][rawValue] }
+  func accepts(_ candidate: HanjaIMECandidate) -> Bool {
+    switch self {
+    case .standard: return true
+    case .hanja: return candidate.kind == .hanja
+    case .names: return (candidate.personal && (candidate.personalCategory == nil || candidate.personalCategory == .names)) || candidate.annotation.contains("인명")
+      || candidate.annotation.contains("성씨")
+    case .shinjitai: return candidate.kind == .japanese
+    case .symbols: return candidate.kind == .emoji || candidate.kind == .symbol
+      || candidate.kind == .kaomoji
+    }
+  }
+}
+
+struct HanjaIMEDefinitionRequest: Equatable {
+  let term: String
+  let reading: String
+  let annotation: String
+  let prefersJapaneseDictionary: Bool
+  init(candidate: HanjaIMECandidate, reading: String) {
+    self.term = candidate.sourceValue ?? candidate.value
+    self.reading = candidate.sourceReading ?? reading
+    self.annotation = candidate.annotation
+    self.prefersJapaneseDictionary = candidate.kind == .japanese
+  }
+}
+
+enum HanjaIMEDictionaryLink {
+  static func naver(_ request: HanjaIMEDefinitionRequest) -> URL? {
+    let host = request.prefersJapaneseDictionary ? "ja.dict.naver.com" : "hanja.dict.naver.com"
+    var allowed = CharacterSet.urlQueryAllowed
+    allowed.remove(charactersIn: "&=+#?%")
+    guard !request.term.isEmpty,
+      let query = request.term.addingPercentEncoding(withAllowedCharacters: allowed) else { return nil }
+    return URL(string: "https://" + host + "/#/search?query=" + query)
+  }
+  static func isAllowed(_ url: URL) -> Bool {
+    guard url.scheme == "https", let host = url.host?.lowercased() else { return false }
+    return host == "dict.naver.com" || host.hasSuffix(".dict.naver.com")
+  }
+}
