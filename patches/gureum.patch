+  static func isEmoji(_ value: String) -> Bool {
+    guard !value.isEmpty, value.utf16.count <= 64 else { return false }
+    return value.unicodeScalars.contains { $0.properties.isEmoji && $0.value > 0x7F }
+      && value.unicodeScalars.allSatisfy {
+        $0.properties.isEmoji || $0.value == 0x200D || $0.value == 0xFE0F
+          || $0.value == 0x20E3 || (0xE0020...0xE007F).contains($0.value)
+      }
+  }
+
+  static func isSymbol(_ value: String) -> Bool {
+    guard !value.isEmpty, value.utf16.count <= 64 else { return false }
+    return value.unicodeScalars.allSatisfy { scalar in
+      scalar.properties.isEmoji || scalar.properties.generalCategory == .openPunctuation
+        || scalar.properties.generalCategory == .closePunctuation
+        || scalar.properties.generalCategory == .otherPunctuation
+        || scalar.properties.generalCategory == .mathSymbol
+        || scalar.properties.generalCategory == .otherSymbol
+        || scalar.properties.generalCategory == .modifierSymbol
+        || [0x20, 0x5F, 0x5E, 0x7E, 0x54, 0x6F, 0x77].contains(scalar.value)
+    }
+  }
+
+  static func isLearnable(_ value: String) -> Bool {
+    isHanja(value) || isEmoji(value) || isSymbol(value)
+  }
+
+  static func isReading(_ value: String) -> Bool {
+    !value.isEmpty && value.count <= 64 && value.unicodeScalars.allSatisfy {
+      (0xAC00...0xD7A3).contains($0.value)
+    }
+  }
+
+  static func isHanja(_ value: String) -> Bool {
+    !value.isEmpty && value.unicodeScalars.allSatisfy {
+      (0x3400...0x4DBF).contains($0.value) || (0x4E00...0x9FFF).contains($0.value)
+        || (0xF900...0xFAFF).contains($0.value) || (0x20000...0x323AF).contains($0.value)
+    }
+  }
+
+  static func japaneseVariant(of value: String) -> String? {
+    let converted = String(value.map { shinjitaiVariants[$0] ?? $0 })
+    return converted == value ? nil : converted
+  }
+
+  static func isJapaneseVariantGlyph(_ value: String) -> Bool {
+    value.contains { shinjitaiVariants.values.contains($0) }
+  }
+
+  static func semanticCandidates(for reading: String) -> [HanjaIMECandidate] {
+    (semanticWords[reading] ?? []).map {
+      HanjaIMECandidate(value: $0.0, annotation: $0.1, semantic: true, frequency: $0.2,
+                        sourceReading: reading, sourceValue: $0.0)
+    }
+  }
+
+  static func predictedCandidates(for reading: String) -> [HanjaIMECandidate] {
+    (predictions[reading] ?? []).map {
+      HanjaIMECandidate(value: $0.0, annotation: $0.1, predicted: true, frequency: $0.2,
+                        sourceReading: reading, sourceValue: $0.0)
+    }
+  }
+
+  static func kaomojiCandidates(for reading: String) -> [HanjaIMECandidate] {
+    (kaomoji[reading] ?? []).map {
+      HanjaIMECandidate(value: $0.0, annotation: $0.1, kind: .kaomoji, frequency: 40,
+                        sourceReading: reading, sourceValue: $0.0)
+    }
+  }
+
+  static func relatedSymbols(for symbol: String) -> [HanjaIMECandidate] {
+    let groups: [[String]] = [
+      ["「", "」", "『", "』", "【", "】", "〔", "〕", "〈", "〉", "《", "》", "｛", "｝"],
+      ["(", ")", "（", "）", "[", "]", "［", "］", "{", "}", "｛", "｝"],
+      [".", "。", "．", "…", "‥", "・", "ㆍ", "·"],
+      ["-", "—", "―", "─", "〜", "～", "_", "＿"],
+      ["!", "！", "?", "？", ",", "，", "、", ";", "；", ":", "："],
+    ]
+    guard let group = groups.first(where: { $0.contains(symbol) }) else { return [] }
+    return group.filter { $0 != symbol }.map {
+      HanjaIMECandidate(value: $0, annotation: "관련 기호", kind: .symbol, frequency: 60,
+                        sourceReading: symbol, sourceValue: $0)
+    }
+  }
+
+  static func rank(_ candidates: [HanjaIMECandidate], reading: String,
+                   counts: [String: Int], recent: [String: Double] = [:]) -> [HanjaIMECandidate] {
+    guard isReading(reading) || !reading.isEmpty else { return [] }
+    var seen = Set<String>()
+    let unique = candidates.compactMap { candidate -> HanjaIMECandidate? in
+      let value = candidate.value.precomposedStringWithCanonicalMapping
+      let valid: Bool
+      switch candidate.kind {
+      case .hanja, .japanese:
+        valid = isHanja(value) || (candidate.sourceValue.map { isHanja($0) && value.hasPrefix($0) } ?? false)
+      case .emoji: valid = isEmoji(value)
+      case .symbol, .kaomoji: valid = isSymbol(value)
+      }
+      guard valid, seen.insert(value).inserted else {
+        return nil
+      }
+      return HanjaIMECandidate(value: value, annotation: candidate.annotation, kind: candidate.kind,
+                              personal: candidate.personal, predicted: candidate.predicted,
+                              semantic: candidate.semantic, frequency: candidate.frequency,
+                              sourceReading: candidate.sourceReading, sourceValue: candidate.sourceValue,
+                              personalCategory: candidate.personalCategory)
+    }
+    let defaults = preferred[reading] ?? []
+    return unique.enumerated().sorted { a, b in
+      func group(_ candidate: HanjaIMECandidate) -> Int {
+        switch candidate.kind {
+        case .hanja: return 0
+        case .japanese: return 1
+        case .emoji, .symbol, .kaomoji: return 2
+        }
+      }
+      if group(a.element) != group(b.element) { return group(a.element) < group(b.element) }
+      let ac = counts[a.element.value] ?? 0
+      let bc = counts[b.element.value] ?? 0
+      if ac != bc { return ac > bc }
+      let ar = recent[a.element.value] ?? 0
+      let br = recent[b.element.value] ?? 0
+      if ar != br { return ar > br }
+      if a.element.personal != b.element.personal { return a.element.personal }
+      if a.element.predicted != b.element.predicted {
+        // Complete words win over longer, unmeasured dictionary prefixes.
+        // Single-syllable input can still suggest curated frequent words.
+        if reading.count > 1 { return !a.element.predicted }
+        if a.element.frequency == 0 || b.element.frequency == 0 {
+          return a.element.frequency > b.element.frequency
+        }
+      }
+      if a.element.semantic != b.element.semantic { return !a.element.semantic }
+      if a.element.frequency != b.element.frequency { return a.element.frequency > b.element.frequency }
+      let ap = defaults.firstIndex(of: a.element.value) ?? Int.max
+      let bp = defaults.firstIndex(of: b.element.value) ?? Int.max
+      if ap != bp { return ap < bp }
+      return a.offset < b.offset
+    }.map { $0.element }
+  }
+}
+
+enum HanjaIMEOptionSymbols {
+  // Shift positions of libhangul 2y, used as an Option layer in HanjaIME.
+  static let yetKeys = Set("abcdfghklnsvxz".map(String.init))
+  static func yetKey(key: String, shift: Bool) -> String? {
+    if key == "l" && shift { return nil }
+    return yetKeys.contains(key) ? key.uppercased() : nil
+  }
+  static func literal(key: String, shift: Bool) -> String? {
+    if key == "l" && shift { return "ᆘ" }
+    let pairs: [String: (String, String)] = [
+      ";": ("…", "…"), "e": ("ㅼ", "ㅼ"),
+      "u": ("ᆍ", "ᆍ"), "r": ("ᅚ", "ᅚ"), ".": ("ㆍ", "ᆞ"),
+    ]
+    guard let pair = pairs[key] else { return nil }
+    return shift ? pair.1 : pair.0
+  }
+}
+
+enum HanjaIMECompound {
+  // Productive Sino-Korean suffixes supplement exact words, never replace them.
+  // Keep copula/particle candidates as alternatives (e.g. 英國인).
+  static let suffixes: [Character: String] = ["인": "人", "적": "的", "화": "化", "성": "性", "론": "論", "학": "學"]
+  static func candidates(reading: String, exact: (String) -> [HanjaIMECandidate]) -> [HanjaIMECandidate] {
+    guard reading.count >= 3, let last = reading.last, let suffix = suffixes[last] else { return [] }
+    let stem = String(reading.dropLast())
+    return exact(stem).filter { $0.kind == .hanja && !$0.predicted && HanjaIMERanking.isHanja($0.value) }.prefix(8).map {
+      let value = $0.value + suffix
+      return HanjaIMECandidate(value: value, annotation: ($0.annotation.isEmpty ? stem : $0.annotation) + " · " + String(last) + "(" + suffix + ")",
+        sourceReading: reading, sourceValue: value)
+    }
+  }
+}
+
+enum HanjaIMEInflection {
+  // Conservative, explicit suffix rules. Never guess a Hanja for every syllable.
+  static let endings: Set<String> = [
+    "하다", "하는", "하면", "하며", "하고", "하지", "하지만", "하려고", "하려면",
+    "하니", "하니까", "하네요", "하나요", "하죠", "하자", "하라", "하던", "하든",
+    "하겠습니다", "하겠어요", "하겠네", "하세요", "하셔요", "하십니다", "하십니까",
+    "하신", "하실", "하시는", "하셨다", "하셨어요", "하셨습니다",
+    "합니다", "합니까", "한다", "한", "할", "할까", "할까요",
+    "해", "해요", "해서", "해도", "해줘", "해주세요", "해주시고", "해주셔서",
+    "했다", "했어요", "했습니다", "했으니", "했지만", "했던", "했네요",
+    "되다", "되는", "되면", "되고", "되니", "됩니다", "된", "될", "됐다", "됐어요",
+    "되었다", "되었습니다", "되어", "되어서", "돼", "돼요", "되지", "되지만",
+    "이다", "입니다", "입니까", "인", "인가", "인가요", "인지", "인데", "인데요",
+    "이고", "이며", "이면", "이어서", "이라", "이라서", "이란", "이라는", "이라고",
+    "이었다", "이었어요", "이었습니다", "이에요", "예요", "였다", "였어요", "였습니다",
+  ]
+
+  static func accepts(_ suffix: String) -> Bool {
+    if endings.contains(suffix) { return true }
+    // Allow at most three particle pieces: 학교 + 에서 + 는, 가나다 + 에게 + 도.
+    var tails: Set<String> = [suffix]
+    for _ in 0..<3 {
+      var next = Set<String>()
+      for tail in tails {
+        if HanjaIMERanking.particles.contains(tail) { return true }
+        for particle in HanjaIMERanking.particles where tail.hasPrefix(particle) {
+          let rest = String(tail.dropFirst(particle.count))
+          if !rest.isEmpty { next.insert(rest) }
+        }
+      }
+      tails = next
+    }
+    return false
+  }
+
+  static func candidates(reading: String, exact: (String) -> [HanjaIMECandidate]) -> [HanjaIMECandidate] {
+    guard reading.count > 2 else { return [] }
+    // Prefer the longest known stem, keeping the entire suffix unchanged.
+    for length in stride(from: reading.count - 1, through: 2, by: -1) {
+      let stem = String(reading.prefix(length))
+      let suffix = String(reading.dropFirst(length))
+      guard accepts(suffix) else { continue }
+      let found = exact(stem).filter { $0.kind == .hanja }
+      if !found.isEmpty {
+        return found.map {
+          HanjaIMECandidate(value: $0.value + suffix, annotation: $0.annotation,
+                            personal: $0.personal, sourceReading: stem, sourceValue: $0.value,
+                            personalCategory: $0.personalCategory)
+        }
+      }
+    }
+    return []
+  }
+}
+
+protocol HanjaIMEHangulBuffer: AnyObject {
+  var composedString: String { get }
+  @discardableResult func dequeueCommitString() -> String
+  func cancelComposition()
+  func clearCompositionContext()
+}
+
+enum HanjaIMEAction {
+  case text, backspace, space(preserveHangul: Bool), enter, escape
+  case next, previous, pageNext, pagePrevious, number(Int), literal(String), passThrough
+}
+
+/// Runs serially on the input thread; only explicit selections are learned.
+final class HanjaIMESession {
+  let hangul: HanjaIMEHangulBuffer
+  let usage: HanjaIMEUsageStore
+  private let lookup: (String) -> [HanjaIMECandidate]
+  private let predict: (String) -> [HanjaIMECandidate]
+  private var buffered = ""
+  private(set) var commitString = ""
+  private(set) var candidates: [HanjaIMECandidate] = []
+  private(set) var candidateReading = ""
+  private(set) var generation: UInt64 = 0
+  private(set) var selectedIndex = 0
+  private(set) var selectionEngaged = false
+  private(set) var category: HanjaIMECandidateCategory = .standard
+  private(set) var unfilteredCandidateCount = 0
+  private(set) var layoutCandidates: [HanjaIMECandidate] = []
+  var wantsCandidatePanel: Bool {
+    !reading.isEmpty && (unfilteredCandidateCount > 0 || category != .standard)
+  }
+  func setCategory(_ category: HanjaIMECandidateCategory) {
+    self.category = category
+    if layoutCandidates.isEmpty { refresh(manual: true); return }
+    generation &+= 1
+    selectedIndex = 0
+    selectionEngaged = false
+    candidates = layoutCandidates.filter(category.accepts)
+  }
+  var automaticCandidates = true
+  var reading: String { buffered + hangul.composedString }
+  // Punctuation and spaces stay inside the marked-text session.  Conversion
+  // always operates on the final Hangul run, rather than accidentally trying
+  // to treat a whole sentence as one dictionary key.
+  var conversionReading: String {
+    String(reading.reversed().prefix { character in
+      character.unicodeScalars.allSatisfy { (0xAC00...0xD7A3).contains($0.value) }
+    }.reversed())
+  }
+  var displayString: String {
+    guard selectionEngaged, candidates.indices.contains(selectedIndex), !candidateReading.isEmpty else {
+      return reading
+    }
+    return String(reading.dropLast(candidateReading.count)) + candidates[selectedIndex].value
+  }
+
+  init(hangul: HanjaIMEHangulBuffer, usage: HanjaIMEUsageStore,
+       predict: @escaping (String) -> [HanjaIMECandidate] = { _ in [] },
+       lookup: @escaping (String) -> [HanjaIMECandidate]) {
+    self.hangul = hangul
+    self.usage = usage
+    self.lookup = lookup
+    self.predict = predict
+  }
+
+  func refresh(manual: Bool = false) {
+    buffered += hangul.dequeueCommitString()
+    generation &+= 1
+    selectedIndex = 0
+    selectionEngaged = false
+    candidateReading = conversionReading
+    guard reading.count <= 128 else { commitRaw(); return }
+    guard (automaticCandidates || manual), HanjaIMERanking.isReading(candidateReading),
+      manual || !HanjaIMERanking.particles.contains(candidateReading) || HanjaIMERanking.semanticWords[candidateReading] != nil else {
+        candidates = []; layoutCandidates = []; unfilteredCandidateCount = 0; return
+      }
+    let exact = rankedExact(candidateReading)
+    let inflected = HanjaIMEInflection.candidates(reading: candidateReading, exact: rankedExact)
+    let semantic = HanjaIMERanking.semanticCandidates(for: candidateReading)
+    let predicted = HanjaIMERanking.predictedCandidates(for: candidateReading) + predict(candidateReading)
+    let kaomoji = HanjaIMERanking.kaomojiCandidates(for: candidateReading)
+    let emoji = HanjaIMEEmojiLexicon.candidates(for: candidateReading)
+    let variants = (exact + predicted + semantic).compactMap { candidate -> HanjaIMECandidate? in
+      guard candidate.kind == .hanja, let value = HanjaIMERanking.japaneseVariant(of: candidate.value) else { return nil }
+      return HanjaIMECandidate(value: value, annotation: candidate.annotation + " · 신자체",
+        kind: .japanese, predicted: candidate.predicted, frequency: candidate.frequency,
+        sourceReading: candidate.sourceReading ?? candidateReading, sourceValue: value)
+    }
+    // Some source dictionaries already contain a Japanese simplified form.
+    // Classify it before de-duplication so the 신자체 tab can still expose it
+    // instead of allowing a Korean-hanja entry to hide the same glyph.
+    let normalized = (exact + inflected + predicted + semantic + variants + kaomoji + emoji).map { candidate -> HanjaIMECandidate in
+      guard candidate.kind == .hanja,
+        HanjaIMERanking.isJapaneseVariantGlyph(candidate.value) else { return candidate }
+      return HanjaIMECandidate(value: candidate.value, annotation: candidate.annotation + " · 신자체",
+        kind: .japanese, personal: candidate.personal, predicted: candidate.predicted,
+        semantic: candidate.semantic, frequency: candidate.frequency,
+        sourceReading: candidate.sourceReading, sourceValue: candidate.sourceValue,
+        personalCategory: candidate.personalCategory)
+    }
+    let allCandidates = HanjaIMERanking.rank(normalized,
+      reading: candidateReading, counts: usage.snapshot(reading: candidateReading),
+      recent: usage.recency(reading: candidateReading))
+    unfilteredCandidateCount = allCandidates.count
+    layoutCandidates = allCandidates
+    candidates = allCandidates.filter(category.accepts)
+  }
+
+  private func rankedExact(_ reading: String) -> [HanjaIMECandidate] {
+    let compounds = HanjaIMECompound.candidates(reading: reading) { stem in
+      HanjaIMERanking.rank(self.usage.personalCandidates(reading: stem) + self.lookup(stem),
+        reading: stem, counts: self.usage.snapshot(reading: stem), recent: self.usage.recency(reading: stem))
+    }
+    return HanjaIMERanking.rank(usage.personalCandidates(reading: reading) + lookup(reading) + compounds,
+                         reading: reading, counts: usage.snapshot(reading: reading),
+                         recent: usage.recency(reading: reading))
+  }
+
+  @discardableResult
+  func requestConversion() -> Bool {
+    refresh(manual: true)
+    selectionEngaged = !candidates.isEmpty
+    return selectionEngaged
+  }
+
+  func commitCurrent() {
+    if !selectionEngaged || !choose(index: selectedIndex) { commitRaw() }
+  }
+
+  func takeCommit() -> String {
+    let value = commitString
+    commitString = ""
+    return value
+  }
+
+  private func invalidateCandidates() {
+    generation &+= 1
+    candidates = []
+    layoutCandidates = []
+    unfilteredCandidateCount = 0
+    category = .standard
+    candidateReading = ""
+    selectedIndex = 0
+    selectionEngaged = false
+  }
+
+  func commitRaw(suffix: String = "") {
+    hangul.cancelComposition()
+    buffered += hangul.dequeueCommitString()
+    commitString += buffered + suffix
+    buffered = ""
+    invalidateCandidates()
+  }
+
+  func clear() {
+    hangul.clearCompositionContext()
+    buffered = ""
+    commitString = ""
+    invalidateCandidates()
+  }
+
+  @discardableResult
+  func choose(index: Int, generation expected: UInt64? = nil) -> Bool {
+    guard expected == nil || expected == generation, !candidateReading.isEmpty, reading.hasSuffix(candidateReading),
+      candidates.indices.contains(index) else { return false }
+    let candidate = candidates[index]
+    usage.record(reading: candidate.sourceReading ?? candidateReading, value: candidate.sourceValue ?? candidate.value)
+    commitString += String(reading.dropLast(candidateReading.count)) + candidate.value
+    buffered = ""
+    hangul.clearCompositionContext()
+    invalidateCandidates()
+    return true
+  }
+
+  func highlight(index: Int, generation expected: UInt64) {
+    guard expected == generation, candidates.indices.contains(index) else { return }
+    selectedIndex = index
+    selectionEngaged = true
+  }
+
+  private func acceptSelectionInline() {
+    guard selectionEngaged, candidates.indices.contains(selectedIndex), !candidateReading.isEmpty else { return }
+    let candidate = candidates[selectedIndex]
+    usage.record(reading: candidate.sourceReading ?? candidateReading, value: candidate.sourceValue ?? candidate.value)
+    let replacement = String(reading.dropLast(candidateReading.count)) + candidate.value
+    hangul.clearCompositionContext()
+    buffered = replacement
+    invalidateCandidates()
+  }
+
+  private func appendLiteral(_ text: String) {
+    acceptSelectionInline()
+    hangul.cancelComposition()
+    buffered += hangul.dequeueCommitString()
+    buffered += text
+    let symbols = HanjaIMERanking.relatedSymbols(for: text)
+    guard !symbols.isEmpty else { refresh(); return }
+    generation &+= 1
+    selectedIndex = 0
+    selectionEngaged = false
+    candidateReading = text
+    unfilteredCandidateCount = symbols.count
+    layoutCandidates = symbols
+    candidates = symbols.filter(category.accepts)
+  }
+
+  /// true consumes the event; false lets the host application handle it once.
+  func handle(_ action: HanjaIMEAction, feedHangul: () -> Bool = { false }) -> Bool {
+    switch action {
+    case .text:
+      acceptSelectionInline()
+      let handled = feedHangul()
+      refresh()
+      if !handled { commitRaw() }
+      return handled
+    case .backspace:
+      if selectionEngaged { refresh(); return true }
+      let handled = feedHangul()
+      if !handled, !buffered.isEmpty { buffered.removeLast(); refresh(); return true }
+      refresh()
+      return handled
+    case .space(let preserve):
+      if !preserve, !candidates.isEmpty {
+        selectedIndex = selectionEngaged ? (selectedIndex + 1) % candidates.count : 0
+        selectionEngaged = true
+        return true
+      }
+      if reading.isEmpty { return false }
+      if preserve { selectionEngaged = false }
+      appendLiteral(" ")
+      return true
+    case .enter:
+      if selectionEngaged, choose(index: selectedIndex) { return true }
+      guard !reading.isEmpty else { return false }
+      commitRaw()
+      return true
+    case .escape:
+      if selectionEngaged { refresh(); return true }
+      guard !reading.isEmpty else { return false }
+      commitRaw()
+      return true
+    case .next, .previous, .pageNext, .pagePrevious:
+      guard !candidates.isEmpty else { commitRaw(); return false }
+      switch action {
+      case .next: selectedIndex = selectionEngaged ? (selectedIndex + 1) % candidates.count : 0
+      case .previous: selectedIndex = selectionEngaged ? (selectedIndex + candidates.count - 1) % candidates.count : candidates.count - 1
+      case .pageNext: selectedIndex = min(selectedIndex + 9, candidates.count - 1)
+      case .pagePrevious: selectedIndex = max(selectedIndex - 9, 0)
+      default: break
+      }
+      selectionEngaged = true
+      return true
+    case .number(let number):
+      if selectionEngaged, (1...9).contains(number) {
+        // The native panel is configured with nine selection keys per page.
+        let index = (selectedIndex / 9) * 9 + number - 1
+        _ = choose(index: index)
+        return true
+      }
+      commitRaw(suffix: String(number))
+      return true
+    case .literal(let text):
+      appendLiteral(text)
+      return true
+    case .passThrough:
+      commitCurrent()
+      return false
+    }
+  }
+}
+
